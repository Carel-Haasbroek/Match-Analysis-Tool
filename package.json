{
  "name": "video-notes",
  "version": "1.0.3",
  "private": true,
  "description": "Match analysis tool - timestamped drawings and notes over local video and YouTube",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node electron/selftest.js && node electron/storetest.js",
    "dist": "electron-builder && node build/sort-dist.js",
    "icon": "node build/make-icon.js"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.videonotes.app",
    "productName": "Video Notes",
    "publish": [
      {
        "provider": "github",
        "owner": "Carel-Haasbroek",
        "repo": "Match-Analysis-Tool",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/main.js",
      "electron/preload.js",
      "electron/server.js",
      "electron/store.js",
      "electron/datadir.js",
      "electron/folderstore.js",
      "app.html",
      "styles.css",
      "app.js",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Video Notes",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "VideoNotes-${version}-portable.exe"
    }
  }
}
